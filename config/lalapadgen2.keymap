#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Default    0
#define Number    1
#define Symbol    2
#define Arrow    3
#define Numpad    4
#define System    5

&mt {
    tapping-term-ms = <275>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
    quick-tap-ms = <175>;
    hold-trigger-on-release;
};

&lt {
    tapping-term-ms = <275>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    hold-trigger-on-release;
};

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 3>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Default {
            display-name = "Default";
            bindings = <
&kp Q      &kp W       &kp E        &kp R         &kp T                                &kp Y      &kp U         &kp I        &kp O       &kp P
&kp A      &mt LALT S  &mt LCTRL D  &mt LSHIFT F  &kp G                                &kp H      &mt LSHIFT J  &mt LCTRL K  &mt LALT L  &kp MINUS
&kp Z      &kp X       &kp C        &kp V         &kp B                                &kp N      &kp M         &kp COMMA    &kp PERIOD  &kp SLASH
&none      &none       &kp TAB      &mo 1         &mo 3      &kp SPACE  &kp BACKSPACE  &kp ENTER  &mo 2         &none        &kp LGUI    &kp ESC
           &to 3       &kp RIGHT    &kp DOWN      &kp LEFT   &kp UP     &kp UP         &kp LEFT   &kp DOWN      &kp RIGHT    &to 1
&mkp LCLK  &mkp RCLK   &mkp MCLK                                                                                &mkp LCLK    &mkp RCLK   &mkp MCLK
&mkp MB5   &mkp MB4    &kp LG(TAB)  &kp LG(D)     &kp LCTRL                            &mkp MB5   &mkp MB4      &kp LG(TAB)  &kp LG(D)   &kp LCTRL
            >;
        };

        Number {
            display-name = "Number";
            bindings = <
&none       &kp KP_N7  &kp KP_N8  &kp KP_N9  &none                          &none      &none      &kp UP        &none      &none
&kp KP_N0   &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp F4                         &none      &kp LEFT   &kp DOWN      &kp RIGHT  &none
&kp PERIOD  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp COLON                      &kp PLUS   &kp MINUS  &kp ASTERISK  &kp SLASH  &kp EQUAL
&kp LALT    &kp LCTRL  &kp LSHFT  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp DEL  &kp ENTER  &mo 4      &none         &none      &kp ESC
            &to 0      &trans     &trans     &trans     &trans     &trans   &trans     &trans     &trans        &to 0
&trans      &trans     &trans                                                                     &trans        &trans     &trans
&trans      &trans     &trans     &trans     &trans                         &trans     &trans     &trans        &trans     &trans
            >;
        };

        Symbol {
            display-name = "Symbol";
            bindings = <
&kp SQT   &kp DQT        &kp EXCL    &none     &kp TILDE                      &none          &kp LBRC  &kp RBRC   &none     &kp PERCENT
&kp AT    &kp SEMICOLON  &kp DOLLAR  &none     &kp HASH                       &kp CARET      &kp LPAR  &kp RPAR   &none     &none
&none     &none          &kp COLON   &kp PIPE  &kp BACKSLASH                  &kp AMPERSAND  &kp LBKT  &kp RBKT   &none     &none
&kp LALT  &kp LCTRL      &kp LSHFT   &none     &none          &none   &none   &none          &none     &kp LANG1  &kp CAPS  &kp LANG2
          &to 0          &trans      &trans    &trans         &trans  &trans  &trans         &trans    &trans     &to 0
&trans    &trans         &trans                                                                        &trans     &trans    &trans
&trans    &trans         &trans      &trans    &trans                         &trans         &trans    &trans     &trans    &trans
            >;
        };

        Arrow {
            display-name = "Arrow";
            bindings = <
&none     &kp LA(LEFT)  &kp UP    &kp LA(RIGHT)  &none                       &none   &kp CAPS    &kp TAB    &none         &none
&kp HOME  &kp LEFT      &kp DOWN  &kp RIGHT      &kp END                     &none   &kp LSHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI
&none     &kp PAGE_UP   &none     &kp PAGE_DOWN  &none                       &none   &none       &none      &none         &none
&kp ESC   &none         &none     &none          &kp DEL  &kp ENTER  &none   &none   &none       &none      &none         &none
          &to 0         &trans    &trans         &trans   &trans     &trans  &trans  &trans      &trans     &to 0
&trans    &trans        &trans                                                                   &trans     &trans        &trans
&trans    &trans        &trans    &trans         &trans                      &trans  &trans      &trans     &trans        &trans
            >;
        };

        Function {
            bindings = <
&trans   &kp F7  &kp F8  &kp F9  &trans                  &trans        &trans        &trans        &trans        &trans
&kp F10  &kp F4  &kp F5  &kp F6  &trans                  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans   &kp F1  &kp F2  &kp F3  &trans                  &trans        &trans        &trans        &trans        &trans
&trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
         &to 0   &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &to 0
&trans   &trans  &trans                                                              &trans        &trans        &trans
&trans   &trans  &trans  &trans  &trans                  &trans        &trans        &trans        &trans        &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
